/target
/dist
**/.DS_Store
.DS_Store

# npm wrapper build artefacts
/npm/vendor
/npm/LICENSE
/npm/*.tgz
/npm/pack.json

# Impeccable engine binary: platform specific and fetched on first run by the
# launcher that ships beside it. Same principle as /npm/vendor: no binaries in
# the repository.
**/skills/impeccable/scripts/bin/

# Impeccable machine local settings (hook consent, per machine overrides).
.impeccable/config.local.json

# Impeccable decision page runtime state (one round's answer and log).
.impeccable/questions/

__pycache__/

# Scratch space: image generation candidates and other local working files.
/tmp/

# Generated image candidates. The ones the site actually ships are committed
# under website/assets/, together with the prompt that produced them.
/output/

# Impeccable review evidence: the captured viewports the finish review read. The
# site itself ships no raster, so the captures stay local to the run.
.impeccable/review/
